<?xml version="1.0" encoding="utf-8"?>
<!-- pane_layout's top-bar pills: dark glass, so white labels stay sharp over the light frosted header; white when
     focused, as pill_bg. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#80000000" android:endColor="#66000000" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
